{
  "name": "sip-pbx",
  "main": "index.js",
  "compatibility_date": "2026-01-01",
  "durable_objects": {
    "bindings": [{ "name": "CALL_SESSION", "class_name": "CallSession" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CallSession"] }],
  "sip": {
    "domains": ["sip.example.com"],
    "listeners": [
      { "protocol": "udp", "port": 5060 },
      { "protocol": "ws", "port": 8080, "path": "/sip" }
    ],
    "auto_100_trying": true
  }
}
